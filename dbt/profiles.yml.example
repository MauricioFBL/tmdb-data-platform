tmdb_data_platform:
  target: dev
  outputs:
    dev:
      type: glue
      role_arn: "arn:aws:iam::<account_id>:role/tmdb-data-platform-dbt-glue-session"
      region: us-east-1
      glue_version: "4.0"
      workers: 2
      worker_type: G.1X
      schema: tmdb_silver_gold
      session_provisioning_timeout_in_seconds: 120
      location: "s3://tmdb-data-platform/dbt-glue-tmp/"
      datalake_formats: iceberg
      # AWS's own guidance recommends commit locking for concurrent-write
      # safety on Iceberg snapshots/incrementals in production — treat as
      # needed by default pending verification against a real Glue 4.0+
      # session (see ADR-0004 and ADR-0005).
      conf: >-
        --conf spark.sql.extensions=org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions
        --conf spark.sql.catalog.glue_catalog=org.apache.iceberg.spark.SparkCatalog
        --conf spark.sql.catalog.glue_catalog.warehouse=s3://tmdb-data-platform/silver/
        --conf spark.sql.catalog.glue_catalog.catalog-impl=org.apache.iceberg.aws.glue.GlueCatalog
        --conf spark.sql.catalog.glue_catalog.io-impl=org.apache.iceberg.aws.s3.S3FileIO
        --conf spark.sql.catalog.glue_catalog.lock-impl=org.apache.iceberg.aws.dynamodb.DynamoDbLockManager
        --conf spark.sql.catalog.glue_catalog.lock.table=tmdb_data_platform_iceberg_lock
      threads: 4
