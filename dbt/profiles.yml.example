tmdb_data_platform:
  target: dev
  outputs:
    dev:
      type: athena
      s3_staging_dir: "s3://tmdb-data-platform/athena-staging/"
      s3_data_dir: "s3://tmdb-data-platform/gold/"
      s3_data_naming: schema_table
      region_name: us-east-1
      schema: tmdb_gold
      database: awsdatacatalog
      work_group: tmdb-data-platform
      threads: 4
      # work_group must run Athena engine v3 — MERGE INTO on Iceberg is
      # only supported there (see ADR-0004).
      # num_retries capped low: the adapter's default retry (5) blindly
      # re-runs failed Iceberg CTAS/timeout errors that won't self-heal
      # on retry (dbt-labs/dbt-adapters #1739, #1813) — see ADR-0004.
      num_retries: 1
