# TMDB API — https://developer.themoviedb.org/docs/authentication-application
TMDB_API_READ_ACCESS_TOKEN=

# AWS
AWS_REGION=us-east-1
AWS_PROFILE=tmdb-data-platform

# S3 layout (see PROJECT_PLAN.md Section 6)
S3_BUCKET=tmdb-data-platform
S3_RAW_PREFIX=raw/
S3_BRONZE_PREFIX=bronze/
S3_SILVER_PREFIX=silver/
S3_GOLD_PREFIX=gold/
S3_MANIFESTS_PREFIX=manifests/
S3_CHECKPOINTS_PREFIX=checkpoints/
S3_ERRORS_PREFIX=errors/

# Glue Data Catalog
GLUE_DATABASE_BRONZE=tmdb_bronze
GLUE_DATABASE_SILVER=tmdb_silver

# Athena (used by dbt-athena for Gold marts — see ADR-0002)
ATHENA_WORKGROUP=tmdb-data-platform
ATHENA_STAGING_S3_PATH=s3://tmdb-data-platform/athena-staging/
ATHENA_SCHEMA=tmdb_gold
